# Local development. SHADOW_DATABASE_URL is used only by `prisma migrate dev`.
DATABASE_URL="postgresql://repetition_app:repetition_local@localhost:5432/repetition?schema=public"
SHADOW_DATABASE_URL="postgresql://repetition_app:repetition_local@localhost:5432/repetition_shadow?schema=public"

# Supabase (see docs/DEPLOY.md) — keep these in .env.supabase, not in .env:
# DATABASE_URL = transaction pooler, port 6543, ending ?pgbouncer=true&connection_limit=1
# DIRECT_URL   = session pooler, port 5432; the Prisma CLI (migrations) connects with it
# Don't set SHADOW_DATABASE_URL in production.

# Used only by the seed command that creates or resets the administrator.
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
