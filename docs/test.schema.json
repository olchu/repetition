{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repetition.local/schemas/test-1.0.json",
  "title": "Repetition test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "subject",
    "grade",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "subject": {
      "type": "string",
      "enum": [
        "science",
        "geography",
        "history",
        "mathematics"
      ]
    },
    "grade": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "passPercentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 70
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "options",
        "correctOptionId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "minLength": 1,
          "maxLength": 100
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "explanation": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "minLength": 1,
          "maxLength": 100
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
