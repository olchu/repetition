{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repetition.local/schemas/test-1.0.json",
  "title": "Repetition test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "subject",
    "grade",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100,
      "description": "Slug of an active subject from the database catalog."
    },
    "grade": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "passPercentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 70
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "if": {
        "required": ["type"],
        "properties": { "type": { "const": "input" } }
      },
      "then": {
        "required": ["correctAnswers"],
        "properties": { "options": false, "correctOptionId": false }
      },
      "else": {
        "required": ["options", "correctOptionId"],
        "properties": { "correctAnswers": false }
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "description": "\"choice\": pick one of the options. \"input\": type the answer into a field.",
          "enum": ["choice", "input"],
          "default": "choice"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "points": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "correctOptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "correctAnswers": {
          "description": "Accepted answers of an input question; the first is shown as the correct one. Case, extra spaces and the decimal separator (2.3 = 2,3) are ignored, numbers compare by value.",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 200
          }
        },
        "hint": {
          "description": "Markdown. Nudge the child can reveal while the question is still open.",
          "type": "string",
          "maxLength": 5000
        },
        "explanation": {
          "description": "Markdown. Shown after the answer has been checked.",
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "minLength": 1,
          "maxLength": 100
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
